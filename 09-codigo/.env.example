# Authority Engine — variáveis de ambiente
# Copie para .env.local/.env apenas no ambiente de execução.
# Não preencha secrets neste arquivo versionado.

# Runtime relacional obrigatório
PORT=3400
DATABASE_URL=<secret-manager:authorityengine/DATABASE_URL>
AUTHORITY_PROJECT_ID=<project-id>
AUTHORITY_OWNER_ID=<owner-id>
AUTHORITY_ADMIN_TOKEN=<secret-manager:authorityengine/AUTHORITY_ADMIN_TOKEN>
AUTHORITY_OPERATOR_TOKEN=<secret-manager:authorityengine/AUTHORITY_OPERATOR_TOKEN>

# Control Tower / banco provisionado na VPS
CONTROL_TOWER_BASE_URL=https://control-tower.fbr.news
CONTROL_TOWER_PROJECT_ID=dfb080ea-5fa2-4924-bccd-8f121c637e6e
CONTROL_TOWER_SCHEMA_NAME=custom_authorityengine
SUPABASE_URL=https://supabase-control-tower-api.fbr.news
SUPABASE_SERVICE_ROLE_KEY=<secret-manager:fbr/blogs/dfb080ea-5fa2-4924-bccd-8f121c637e6e/SUPABASE_SERVICE_ROLE_KEY>

# Opportunity Radar — obrigatórias para integrações reais; atualmente pendentes
AMAZON_API_URL=
AMAZON_API_KEY=
SECONDARY_MARKETPLACE_API_URL=
SECONDARY_MARKETPLACE_API_KEY=

# Próximos módulos — ainda não consumidas pelo código atual
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# IMAGE_PROVIDER_API_URL=
# IMAGE_PROVIDER_API_KEY=
