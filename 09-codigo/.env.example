# Authority Engine — variáveis de ambiente
# Copie para .env.local/.env apenas no ambiente de execução.
# Não preencha secrets neste arquivo versionado.

# Runtime local
PORT=3400
AUTHORITY_STORE=./data/authority-engine.json

# Control Tower / banco provisionado
CONTROL_TOWER_BASE_URL=http://localhost:3001
CONTROL_TOWER_PROJECT_ID=dfb080ea-5fa2-4924-bccd-8f121c637e6e
CONTROL_TOWER_SCHEMA_NAME=custom_authorityengine
SUPABASE_URL=<secret-manager-reference>
SUPABASE_SERVICE_ROLE_KEY=<secret-manager-reference>
DATABASE_URL=<secret-manager-reference>

# Opportunity Radar — obrigatórias para integrações reais; atualmente pendentes
AMAZON_API_URL=
AMAZON_API_KEY=
SECONDARY_MARKETPLACE_API_URL=
SECONDARY_MARKETPLACE_API_KEY=

# Próximos módulos — ainda não consumidas pelo código atual
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
